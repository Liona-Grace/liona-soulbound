set(root "${CMAKE_CURRENT_BINARY_DIR}/cli-deck-selection")
file(MAKE_DIRECTORY "${root}/decks")
configure_file("${FIXTURES}/cards.json" "${root}/cards.json" COPYONLY)
configure_file("${FIXTURES}/game_config.json" "${root}/game_config.json" COPYONLY)
file(WRITE "${root}/quit.txt" "quit\n")
file(WRITE "${root}/decks/alpha.json" "{\"id\":\"alpha\",\"name\":\"Alpha\",\"cards\":[{\"cardId\":\"knight\",\"count\":1}]}")
file(WRITE "${root}/decks/beta.json" "{\"id\":\"beta\",\"name\":\"Beta\",\"cards\":[{\"cardId\":\"guard\",\"count\":1}]}")
file(WRITE "${root}/decks/draft.json" "{\"id\":\"draft\",\"name\":\"Draft\",\"cards\":[]}")
function(run_cli expected_result expected_text)
    execute_process(COMMAND "${CLI}" "${root}" ${ARGN}
        INPUT_FILE "${root}/quit.txt" OUTPUT_VARIABLE output ERROR_VARIABLE errors
        RESULT_VARIABLE result TIMEOUT 10)
    if(NOT result EQUAL expected_result)
        message(FATAL_ERROR "Unexpected exit ${result}: ${errors}\n${output}")
    endif()
    string(FIND "${output}${errors}" "${expected_text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${expected_text}': ${errors}\n${output}")
    endif()
    if(expected_result EQUAL 0 AND NOT errors STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${errors}")
    endif()
    if(NOT expected_result EQUAL 0 AND output MATCHES "Game started!")
        message(FATAL_ERROR "Invalid decks started a game: ${output}")
    endif()
endfunction()
run_cli(0 "alpha | Alpha | 1/1 | ready" --list-decks)
run_cli(0 "draft | Draft | 0/1 | draft" --list-decks)
run_cli(0 "Knight #1 (ATK 5 | HP 8/8)" alpha beta)
run_cli(0 "Guard #1 (ATK 3 | HP 6/6)" beta alpha)
run_cli(0 "Knight #2 (ATK 5 | HP 8/8)" beta alpha)
run_cli(0 "Game started!" alpha alpha)
run_cli(1 "Deck not found: missing" missing beta)
run_cli(1 "Failed to start game:" draft beta)
run_cli(1 "Usage:" alpha)
file(WRITE "${root}/decks/broken.json" "{")
run_cli(1 "Invalid JSON" broken beta)
run_cli(1 "Invalid JSON" --list-decks)
file(REMOVE "${root}/decks/broken.json")
